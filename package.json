{
    "name": "create-frontend-template",
    "version": "0.17.1",
    "description": "Launcher for frontend template CLIs",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "bin": {
        "create-frontend-template": "./bin/index.mjs"
    },
    "files": [
        "bin"
    ],
    "preferGlobal": true,
    "packageManager": "pnpm@10.18.3",
    "scripts": {
        "build": "pnpm exec vite build && node scripts/write/bin-write.mts",
        "changeset": "changeset",
        "format": "pnpm exec oxfmt --write .",
        "format:check": "pnpm exec oxfmt --check .",
        "lint": "pnpm exec oxlint src scripts vite.config.ts --fix",
        "lint:check": "pnpm exec oxlint src scripts vite.config.ts",
        "lint:fix": "pnpm exec oxlint src scripts vite.config.ts --fix",
        "prepare": "lefthook install",
        "release:pr": "changeset version",
        "version-packages": "changeset version"
    },
    "dependencies": {
        "@clack/prompts": "^0.11.0",
        "commander": "^14.0.2",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.1",
        "@changesets/cli": "^2.29.7",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^25.0.1",
        "lefthook": "^2.1.14",
        "oxfmt": "^0.43.0",
        "oxlint": "^1.58.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0"
    }
}
