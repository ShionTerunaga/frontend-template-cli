{
    "name": "@apps/vue-nuxt-scoped-css",
    "version": "6.0.2",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "postinstall": "nuxt prepare",
        "lint": "oxlint . --fix -D correctness --ignore-path .gitignore",
        "lint:check": "oxlint . -D correctness --ignore-path .gitignore",
        "format": "oxfmt --config .oxfmtrc.json --write .",
        "format:check": "oxfmt --config .oxfmtrc.json --check .",
        "check": "oxlint . -D correctness --ignore-path .gitignore && oxfmt --config .oxfmtrc.json --check .",
        "typecheck": "nuxt typecheck",
        "test": "vitest run",
        "test:unit": "vitest run"
    },
    "dependencies": {
        "@nuxt/image": "2.0.0",
        "jsdom": "^27.4.0",
        "nuxt": "4.4.8",
        "simple-git": "^3.36.0",
        "ts-utility-kit": "2.0.0",
        "valibot": "^1.3.1",
        "vite": "^8.1.0",
        "vitest": "^4.1.0",
        "vue": "^3.5.33",
        "vue-router": "^5.0.6"
    },
    "devDependencies": {
        "@storybook/vue3-vite": "10.3.5",
        "@vitejs/plugin-vue": "^6.0.2",
        "cross-env": "^10.1.0",
        "oxfmt": "^0.53.0",
        "oxlint": "~1.29.0",
        "storybook": "10.3.5"
    }
}
