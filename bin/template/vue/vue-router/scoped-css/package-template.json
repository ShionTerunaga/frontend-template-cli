{
  "name": "@apps/vue-vue-router-scoped-css",
  "version": "6.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "typecheck": "vue-tsc --build",
    "lint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:check": "oxlint . -D correctness --ignore-path .gitignore",
    "format": "oxfmt --config .oxfmtrc.json --write .",
    "format:check": "oxfmt --config .oxfmtrc.json --check .",
    "check": "oxlint . -D correctness --ignore-path .gitignore && oxfmt --config .oxfmtrc.json --check ."
  },
  "dependencies": {
    "csstype": "^3.2.3",
    "ts-utility-kit": "2.0.0",
    "typescript-eslint": "^8.53.0",
    "valibot": "^1.3.1",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "10.3.5",
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.2.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.53.0",
    "oxlint": "~1.29.0",
    "storybook": "10.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
